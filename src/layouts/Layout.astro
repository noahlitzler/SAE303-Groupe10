---
interface Props {
  title?: string;
}

const { title = "Derrière le Prompt" } = Astro.props;
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#090f20" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    min-height: 100%;
  }

  body {
    background: #090f20;
  }
</style>
