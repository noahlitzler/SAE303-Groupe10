<script>
function initExperience(){
 const root=document.querySelector<HTMLElement>('#experience');
 if(!root||root.dataset.initialized==='true')return;
 root.dataset.initialized='true';
 const intro=root.querySelector<HTMLElement>('#intro')!;
 const title=root.querySelector<HTMLButtonElement>('#hero-title')!;
 const form=root.querySelector<HTMLFormElement>('#prompt-form')!;
 const input=root.querySelector<HTMLInputElement>('#prompt-input')!;
 const tokens=root.querySelector<HTMLElement>('#token-display')!;
 const authors=root.querySelector<HTMLElement>('#authors')!;
 const enter=root.querySelector<HTMLButtonElement>('#enter')!;
 const exploration=root.querySelector<HTMLElement>('#exploration')!;
 const cube=root.querySelector<HTMLElement>('#cube')!;
 const faces=Array.from(root.querySelectorAll<HTMLElement>('.cube-face'));
 const buttons=Array.from(root.querySelectorAll<HTMLButtonElement>('.nav-entry'));
 const headerButtons=Array.from(root.querySelectorAll<HTMLButtonElement>('.hud-chapter-link'));
 const fill=root.querySelector<HTMLElement>('#fill')!;
 const counter=root.querySelector<HTMLElement>('#counter')!;
 const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
 let sent=false, titleTimer=0, raf=0;
 // DLP-INTRO-SCROLL-LOCK
 // Bloquer le scroll sur l'accueil jusqu'à l'envoi de la question.
 const lockWheel=(e:WheelEvent)=>{
   if(!sent && window.scrollY < intro.offsetHeight){
     e.preventDefault();
   }
 };
 let touchY=0;
 const lockTouchStart=(e:TouchEvent)=>{
   touchY=e.touches[0]?.clientY ?? 0;
 };
 const lockTouchMove=(e:TouchEvent)=>{
   if(!sent && window.scrollY < intro.offsetHeight && touchY-(e.touches[0]?.clientY ?? touchY)>0){
     e.preventDefault();
   }
 };
 const lockKeys=(e:KeyboardEvent)=>{
   if(sent || window.scrollY >= intro.offsetHeight) return;
   if(['ArrowDown','PageDown',' ','End'].includes(e.key) && !(e.target instanceof HTMLInputElement) && !(e.target instanceof HTMLTextAreaElement)){
     e.preventDefault();
   }
 };
 window.addEventListener('wheel',lockWheel,{passive:false});
 window.addEventListener('touchstart',lockTouchStart,{passive:true});
 window.addEventListener('touchmove',lockTouchMove,{passive:false});
 window.addEventListener('keydown',lockKeys);
 function reveal(){intro.classList.add('revealed')}
 function animateTitle(){reveal();if(reduced)return;title.classList.remove('processing');void title.offsetWidth;title.classList.add('processing');clearTimeout(titleTimer);titleTimer=window.setTimeout(()=>title.classList.remove('processing'),680)}
 title.addEventListener('mouseenter',animateTitle);title.addEventListener('click',animateTitle);title.addEventListener('focus',animateTitle);
 form.addEventListener('submit',e=>{e.preventDefault();const value=input.value.trim();if(!value)return;sent=true;intro.classList.add('sent');tokens.replaceChildren();(value.match(/\S+\s*/g)||[]).slice(0,18).forEach((part,i)=>{const token=document.createElement('span');token.className='token';token.style.animationDelay=`${i*65}ms`;token.textContent=part.trim();tokens.append(token)});const full='NOAH LITZLER · CLÉMENT BERTRAND';if(reduced){authors.textContent=full}else{authors.textContent='';let i=0;const type=()=>{if(!authors.isConnected)return;authors.textContent=full.slice(0,++i);if(i<full.length)window.setTimeout(type,55)};window.setTimeout(type,350)}});
 const scrollTo=(el:HTMLElement)=>el.scrollIntoView({behavior:reduced?'instant':'smooth',block:'start'});
 enter.addEventListener('click',()=>{if(sent)scrollTo(exploration)});
 root.querySelector<HTMLButtonElement>('#brand-logo')?.addEventListener('click',()=>scrollTo(intro));
 function goTo(i:number){const travel=Math.max(1,exploration.offsetHeight-innerHeight);window.scrollTo({top:exploration.getBoundingClientRect().top+scrollY+travel*i/3,behavior:reduced?'instant':'smooth'})}
 buttons.forEach((b,i)=>b.addEventListener('click',()=>goTo(i)));
 headerButtons.forEach((b,i)=>b.addEventListener('click',()=>goTo(i)));
 root.querySelector<HTMLButtonElement>('#outro-restart')?.addEventListener('click',()=>goTo(0));
 // Conclusion : les blocs apparaissent l'un après l'autre quand on y arrive.
 const outroBlocs=Array.from(root.querySelectorAll<HTMLElement>('.outro [data-outro]'));
 outroBlocs.forEach((el,i)=>el.style.transitionDelay=`${Math.min(i,6)*110}ms`);
 if(reduced||!('IntersectionObserver' in window))outroBlocs.forEach(el=>el.classList.add('is-in'));
 else{const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('is-in');io.unobserve(e.target)}}),{threshold:.2});outroBlocs.forEach(el=>io.observe(el))}
 // Pages Explorer : on mémorise la position avant de partir, et on la retrouve au retour
 // (ou la face demandée par ?face=, pour un lien direct depuis une page Explorer).
 root.querySelectorAll<HTMLAnchorElement>('.explore-link').forEach(a=>a.addEventListener('click',()=>{try{sessionStorage.setItem('dlp-retour',JSON.stringify({y:scrollY,face:Number(a.dataset.faceIndex)}))}catch{}}));
 function restaurerPosition(){
  let retour:{y?:number,face?:number}|null=null;
  try{retour=JSON.parse(sessionStorage.getItem('dlp-retour')||'null');sessionStorage.removeItem('dlp-retour')}catch{}
  const face=Number(new URLSearchParams(location.search).get('face'));
  if(retour?.y!=null){sent=true;intro.classList.add('sent');window.scrollTo({top:retour.y,behavior:'instant'})}
  else if(face>=1&&face<=4){sent=true;intro.classList.add('sent');const travel=Math.max(1,exploration.offsetHeight-innerHeight);window.scrollTo({top:exploration.getBoundingClientRect().top+scrollY+travel*(face-1)/3,behavior:'instant'})}
  // ?face= ne sert qu'une fois : un rechargement ultérieur repart de l'introduction.
  if(location.search)history.replaceState(null,'',location.pathname);
 }
 // Le défilement pilote le cube : on restaure nous-mêmes la position, y compris au retour
 // par le bouton Précédent quand le navigateur ressert la page depuis son cache.
 if('scrollRestoration' in history)history.scrollRestoration='manual';
 restaurerPosition();
 addEventListener('pageshow',e=>{if(e.persisted)restaurerPosition()});
 let rotationRaf=0,last=-1;
 function update(){
  rotationRaf=0;
  const rect=exploration.getBoundingClientRect();
  const distance=Math.max(1,rect.height-innerHeight);
  const t=Math.max(0,Math.min(1,-rect.top/distance));
  const position=t*3;
  const active=Math.min(3,Math.max(0,Math.round(position)));
  // Quatre faces solidaires : +90° par changement de graphique (sens inversé).
  cube.style.transform=`translateZ(calc(-1 * var(--face-depth))) rotateX(${position*90}deg)`;
  const inScene=rect.top<innerHeight*.65&&rect.bottom>innerHeight*.35;
  faces.forEach((face,i)=>{
   const interactive=inScene&&active===i&&Math.abs(position-i)<.08;
   face.classList.toggle('is-active',interactive);
   face.setAttribute('aria-hidden',String(!interactive));
   if('inert' in face)face.inert=!interactive;
  });
  buttons.forEach((b,i)=>b.setAttribute('aria-current',String(inScene&&active===i)));
  headerButtons.forEach((b,i)=>b.setAttribute('aria-current',String(inScene&&active===i)));
  fill.style.width=`${Math.round(t*100)}%`;
  counter.textContent=`${String(active+1).padStart(2,'0')} / 04`;
  if(inScene&&active!==last){last=active;const face=faces[active];window.dispatchEvent(new CustomEvent('depth:card-shown',{detail:{card:face}}));}
 }
 function schedule(){if(!rotationRaf)rotationRaf=requestAnimationFrame(update)}
 addEventListener('scroll',schedule,{passive:true});addEventListener('resize',schedule);
 // Réactualisation des cartes et de la taille du cube lors d'un changement de viewport.
 update();
}
initExperience();
document.addEventListener('astro:page-load',initExperience);
</script>
<script is:inline>
/* DLP-METHOD-TRANSITION-V2 */
(function () {
  if (window.__dlpMethodTransition) return;
  window.__dlpMethodTransition = true;

  const style = document.createElement("style");
  style.textContent = `
    .dlp-method-overlay {
      position: fixed;
      inset: 0;
      z-index: 999999;
      display: grid;
      place-items: center;
      background: #070b19;
      opacity: 0;
      pointer-events: none;
      transition: opacity .35s ease;
    }

    .dlp-method-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    .dlp-method-overlay svg {
      width: min(35vw, 320px);
      height: min(35vw, 320px);
      color: #f5f9ff;
      opacity: 0;
      filter: drop-shadow(0 0 35px #8ce8f199);
      transform: scale(.1) rotate(-60deg);
    }

    .dlp-method-overlay.active svg {
      animation: dlp-logo-flight 1.3s ease-in-out forwards;
    }

    .dlp-method-flash {
      position: absolute;
      inset: 0;
      background: #baf8ff;
      opacity: 0;
    }

    .dlp-method-overlay.active .dlp-method-flash {
      animation: dlp-method-flash 1.3s forwards;
    }

    @keyframes dlp-logo-flight {
      0% { opacity: 0; transform: scale(.1) rotate(-60deg); }
      25% { opacity: 1; }
      60% { opacity: 1; transform: scale(1) rotate(0deg); }
      100% { opacity: 1; transform: scale(5) rotate(15deg); }
    }

    @keyframes dlp-method-flash {
      0%, 80% { opacity: 0; }
      100% { opacity: 1; }
    }

    @media (prefers-reduced-motion: reduce) {
      .dlp-method-overlay,
      .dlp-method-overlay * {
        animation: none !important;
        transition: none !important;
      }
    }
  `;
  document.head.appendChild(style);

  document.addEventListener("click", function (event) {
    const link = event.target.closest('a[href="/methode"]');
    if (!link) return;

    if (
      event.defaultPrevented ||
      event.button !== 0 ||
      event.ctrlKey ||
      event.metaKey ||
      event.shiftKey ||
      event.altKey
    ) return;

    event.preventDefault();

    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    if (reduced) {
      window.location.href = link.href;
      return;
    }

    const original = document.querySelector("#brand-logo svg");

    if (!original) {
      window.location.href = link.href;
      return;
    }

    const overlay = document.createElement("div");
    overlay.className = "dlp-method-overlay";
    overlay.setAttribute("aria-hidden", "true");

    const logo = original.cloneNode(true);
    logo.removeAttribute("aria-label");
    logo.removeAttribute("role");

    const flash = document.createElement("div");
    flash.className = "dlp-method-flash";

    overlay.append(logo, flash);
    document.body.appendChild(overlay);

    requestAnimationFrame(() => {
      overlay.classList.add("active");
    });

    setTimeout(() => {
      window.location.href = link.href;
    }, 1300);
  });
})();
</script>
