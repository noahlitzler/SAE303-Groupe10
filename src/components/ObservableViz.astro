---
interface Props {
  viz: "v1" | "v2" | "v3" | "v4";
  label: string;
  class?: string;
}
const { viz, label, class: className } = Astro.props;
---
<figure class:list={["obs-viz", className]} data-obs-viz={viz} aria-label={label} aria-busy="true">
  <div class="obs-viz-stage"></div>
  <p class="obs-viz-status" role="status">CHARGEMENT DE LA VISUALISATION…</p>
</figure>
<style>
.obs-viz{position:relative;margin:0;min-width:0;min-height:0;overflow:hidden;background:#fff}
.obs-viz-stage{position:absolute;top:0;left:0;width:100%;transform-origin:0 0}
.obs-viz-stage > :global(*){max-width:none!important;margin:0}
.obs-viz-status{position:absolute;inset:0;display:grid;place-items:center;margin:0;padding:20px;text-align:center;font:500 10px/1.6 'IBM Plex Mono',monospace;letter-spacing:.1em;color:#aab9d9;pointer-events:none}
.obs-viz.is-ready .obs-viz-status{display:none}
.obs-viz.is-error .obs-viz-status{color:#e66b63}
</style>
<script>
import('../observable/notebook-client').then(({mountObservableNotebook})=>mountObservableNotebook());
</script>
