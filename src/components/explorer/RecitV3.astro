---
// Page « Voir plus » de V3 : l'énergie selon les tâches (AI Energy Score, énergie GPU mesurée).
// Mise en scène : une galerie des dix tâches à retourner (« laquelle consomme le plus ? »),
// une puce GPU qui s'allume (CPU / GPU / mesure / périmètre), puis un atelier échelle linéaire / logarithmique.
import ExplorerGraphique from "./ExplorerGraphique.astro";
import { lireDonnees, fmt, fmtRapport } from "../../data/lecture";
import type { Chapitre } from "../../data/chapitres";

interface Props { chapitre: Chapitre }
const { chapitre: c } = Astro.props;

type Ligne = { tache: string; campagne: string; n_evaluations: number; mediane_Wh_req: number; moyenne_Wh_req: number; min_Wh_req: number; max_Wh_req: number };
const { donnees } = lireDonnees<{ donnees: Ligne[] }>("v3-ai-energy-score-taches.json");
const lignes = donnees.filter((d) => d.campagne === "Février 2025").sort((a, b) => b.mediane_Wh_req - a.mediane_Wh_req);
const haut = lignes[0];
const bas = lignes[lignes.length - 1];
const rapport = haut.mediane_Wh_req / bas.mediane_Wh_req;
const evaluations = lignes.reduce((s, d) => s + d.n_evaluations, 0);
const texte = lignes.find((d) => d.tache === "Génération de texte")!;

// Ce que fait chaque tâche (entrée → sortie), et le petit motif animé qui l'illustre.
const descriptions: Record<string, [string, string]> = {
  "Génération d'images": ["À partir d’une phrase, créer une image.", "creer-image"],
  "Description d'images": ["Regarder une image et la décrire en mots.", "lire-image"],
  "Génération de texte": ["Écrire la suite d’un texte : ce que font les assistants conversationnels.", "ecrire"],
  "Reconnaissance vocale": ["Transformer une voix enregistrée en texte écrit.", "son"],
  "Résumé de texte": ["Raccourcir un long texte en gardant l’essentiel.", "resumer"],
  "Détection d'objets": ["Repérer et encadrer les objets présents dans une image.", "lire-image"],
  "Réponse à des questions": ["Retrouver, dans un texte donné, le passage qui répond à une question.", "ecrire"],
  "Classification d'images": ["Ranger une image dans une catégorie : chat, voiture, paysage…", "trier"],
  "Classification de texte": ["Ranger un texte dans une catégorie : avis positif ou négatif…", "trier"],
  "Similarité de phrases": ["Dire si deux phrases veulent dire à peu près la même chose.", "comparer"],
};
// Ordre de départ de la galerie : mélangé de façon fixe, pour que le classement reste à découvrir.
const ordreGalerie = [3, 7, 0, 9, 4, 2, 8, 5, 1, 6].map((i) => lignes[i]).filter(Boolean);
const lo = Math.log10(bas.mediane_Wh_req) - 0.3, hi = Math.log10(haut.mediane_Wh_req) + 0.1;
const partLog = (v: number) => Math.max(4, (100 * (Math.log10(v) - lo)) / (hi - lo));

// Atelier d'échelle : trois tâches repères.
const reperes = [haut, texte, bas];
const maxLin = haut.mediane_Wh_req;
const loLog = Math.floor(Math.log10(bas.mediane_Wh_req)), hiLog = Math.ceil(Math.log10(haut.mediane_Wh_req));
const graduationsLog = Array.from({ length: hiLog - loLog + 1 }, (_, i) => 10 ** (loLog + i));
const enLog = (v: number) => (100 * (Math.log10(v) - loLog)) / (hiLog - loLog);
---

<div class="ex-recit recit-v3">
  <!-- 1. Ouverture -->
  <section class="ex-hero ex-largeur" aria-labelledby="v3-titre">
    <div class="ex-hero-texte">
      <p class="ex-kicker">VOIR PLUS · CHAPITRE {c.n} — {c.k}</p>
      <h1 id="v3-titre">Changer <em>d’échelle.</em></h1>
      <p class="ex-question"><small>LA QUESTION</small>Créer une image, résumer un texte, trier des avis : est-ce la même dépense d’énergie&nbsp;?</p>
      <p class="ex-hero-lead">Jusqu’ici, nous avons lu des <strong>estimations</strong>. Ce chapitre change de source : des <strong>mesures</strong>, prises en laboratoire sur les puces qui font les calculs.</p>
      <span class="ex-defiler"><i></i>DÉFILEZ POUR COMMENCER</span>
    </div>
    <div class="v3-puce" aria-hidden="true">
      <div class="v3-puce-corps">
        {Array.from({ length: 96 }, (_, i) => <i style={`--d:${((i * 37) % 23) / 10}s`}></i>)}
      </div>
      <span class="v3-puce-nom">GPU</span>
    </div>
  </section>

  <!-- 2a. Les tâches : galerie à retourner -->
  <section class="ex-section ex-largeur" aria-labelledby="v3-taches">
    <div class="ex-entete" data-reveal>
      <p class="ex-kicker">L’IA NE FAIT PAS QUE DU TEXTE</p>
      <h2 class="ex-h2" id="v3-taches">Dix tâches. <em>Devinez laquelle consomme le plus.</em></h2>
      <p class="ex-lead">Les assistants qui écrivent ne sont qu’une partie de l’IA. Voici les {lignes.length} tâches mesurées par AI Energy Score. Retournez les cartes une par une, ou révélez le classement.</p>
    </div>
    <div class="v3-galerie" id="v3-galerie" data-reveal-groupe>
      {ordreGalerie.map((d) => {
        const [phrase, motif] = descriptions[d.tache] ?? ["", "ecrire"];
        return (
          <button type="button" class="v3-tuile" data-valeur={d.mediane_Wh_req} aria-expanded="false" style={`--part:${partLog(d.mediane_Wh_req).toFixed(1)}%`}>
            <span class={`v3-motif v3-motif--${motif}`} aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span class="v3-tuile-nom">{d.tache}</span>
            <span class="v3-tuile-desc">{phrase}</span>
            <span class="v3-tuile-verso">
              <span class="v3-tuile-v">{fmt(d.mediane_Wh_req)} <small>Wh</small></span>
              <span class="v3-tuile-barre"><i></i></span>
              <span class="v3-tuile-n">médiane de {d.n_evaluations} modèles</span>
            </span>
            <span class="v3-tuile-rang" aria-hidden="true"></span>
          </button>
        );
      })}
    </div>
    <div class="v3-galerie-actions" data-reveal>
      <button type="button" class="ex-bouton" id="v3-classer">RÉVÉLER ET CLASSER ↓</button>
      <p class="v3-galerie-note">Barres en échelle logarithmique : chaque cran compte dix fois plus.</p>
    </div>
  </section>

  <!-- 2b. Séquence : qu'est-ce qu'un GPU, et que mesure-t-on ? -->
  <section class="ex-section ex-largeur" aria-labelledby="v3-gpu">
    <div class="ex-entete" data-reveal>
      <p class="ex-kicker">SOUS LE CAPOT</p>
      <h2 class="ex-h2" id="v3-gpu">Qu’est-ce qu’un GPU, <em>et que mesure-t-on ?</em></h2>
    </div>
    <div class="ex-scrolly" data-scrolly id="v3-scrolly">
      <div class="ex-etapes">
        <article class="ex-etape" data-step><div class="ex-etape-carte">
          <span class="ex-etape-n">01 / 04</span>
          <h3>Un processeur classique.</h3>
          <p>Le <span class="ex-terme">CPU</span>, cœur de tout ordinateur, enchaîne les calculs très vite, mais quelques-uns à la fois.</p>
        </div></article>
        <article class="ex-etape" data-step><div class="ex-etape-carte">
          <span class="ex-etape-n">02 / 04</span>
          <h3>Un GPU calcule en parallèle.</h3>
          <p>Le <span class="ex-terme">GPU</span> (processeur graphique), conçu au départ pour les jeux vidéo, réunit des milliers de petites unités qui calculent en même temps.</p>
          <p>C’est ce dont l’IA a besoin : d’immenses quantités d’opérations simples, réalisées simultanément.</p>
        </div></article>
        <article class="ex-etape" data-step><div class="ex-etape-carte">
          <span class="ex-etape-n">03 / 04</span>
          <h3>On mesure son énergie.</h3>
          <p>AI Energy Score fait traiter <strong>1 000 requêtes de test</strong> à chaque modèle, sur une même carte (une NVIDIA H100), et relève l’énergie consommée par le GPU.</p>
          <p>Divisée par 1 000, elle donne des <strong>Wh par requête</strong>.</p>
        </div></article>
        <article class="ex-etape" data-step><div class="ex-etape-carte">
          <span class="ex-etape-n">04 / 04</span>
          <h3>Seule la carte est mesurée.</h3>
          <p>Ni le refroidissement, ni le réseau, ni le bâtiment : un datacenter consomme davantage que ses GPU.</p>
          <p>Ces mesures ne se comparent donc pas directement aux estimations EcoLogits des chapitres précédents.</p>
        </div></article>
      </div>

      <div class="ex-scene v3-scene" aria-hidden="true">
        <div class="v3-perimetre">
          <span class="v3-hors v3-hors--1">REFROIDISSEMENT</span>
          <span class="v3-hors v3-hors--2">RÉSEAU</span>
          <span class="v3-hors v3-hors--3">BÂTIMENT</span>
          <div class="v3-cpu">
            <p>CPU</p>
            <div class="v3-cpu-grille"><i></i><i></i><i></i><i></i></div>
          </div>
          <div class="v3-gpu">
            <p>GPU</p>
            <div class="v3-gpu-grille">{Array.from({ length: 128 }, (_, i) => <i style={`--c:${i % 16};--r:${Math.floor(i / 16)}`}></i>)}</div>
          </div>
          <div class="v3-mesure">
            <span class="v3-mesure-k">WATTMÈTRE · GPU</span>
            <span class="v3-mesure-l">1 000 requêtes → <b>{fmt(haut.mediane_Wh_req)} kWh</b></span>
            <span class="v3-mesure-l">÷ 1 000 = <b>{fmt(haut.mediane_Wh_req)} Wh</b> / requête</span>
            <span class="v3-mesure-ex">ex. : {haut.tache.toLowerCase()}, médiane</span>
          </div>
        </div>
        <p class="ex-scene-legende">SCHÉMA SIMPLIFIÉ · NOMBRE D’UNITÉS NON REPRÉSENTATIF</p>
      </div>
    </div>
  </section>

  <!-- 2c. Atelier : lire des écarts immenses -->
  <section class="ex-section ex-largeur" aria-labelledby="v3-echelle">
    <div class="ex-entete" data-reveal>
      <p class="ex-kicker">AVANT D’EXPLORER</p>
      <h2 class="ex-h2" id="v3-echelle">Des écarts si grands <em>qu’il faut changer de règle.</em></h2>
      <p class="ex-lead">Entre la tâche la plus gourmande et la plus sobre, le rapport atteint environ <strong>{fmtRapport(rapport)}</strong>. Sur une règle ordinaire, les petites valeurs disparaissent. Basculez d’une échelle à l’autre.</p>
    </div>
    <div class="v3-atelier" id="v3-atelier" data-echelle="lin" data-reveal>
      <div class="v3-bascule" role="group" aria-label="Échelle">
        <button type="button" data-e="lin" aria-pressed="true">Linéaire</button>
        <button type="button" data-e="log" aria-pressed="false">Logarithmique</button>
      </div>
      <div class="v3-barres">
        <div class="v3-grad v3-grad--log" aria-hidden="true">{graduationsLog.map((g) => <span style={`left:${enLog(g)}%`}>{fmt(g)}</span>)}</div>
        {reperes.map((d) => (
          <div class="v3-barre" style={`--lin:${(100 * d.mediane_Wh_req / maxLin).toFixed(3)}%;--log:${enLog(d.mediane_Wh_req).toFixed(2)}%`}>
            <span class="v3-barre-nom">{d.tache}</span>
            <span class="v3-barre-piste"><i></i></span>
            <span class="v3-barre-v">{fmt(d.mediane_Wh_req)} Wh</span>
          </div>
        ))}
      </div>
      <p class="v3-atelier-txt v3-txt-lin"><strong>Échelle linéaire :</strong> la longueur est proportionnelle à la valeur. La similarité de phrases devient une barre invisible.</p>
      <p class="v3-atelier-txt v3-txt-log"><strong>Échelle logarithmique :</strong> chaque graduation vaut dix fois la précédente. Tout est visible, mais les écarts paraissent bien plus petits qu’ils ne sont.</p>
    </div>
  </section>

  <!-- 3. Méthode et données -->
  <section class="ex-section ex-largeur" aria-labelledby="v3-methode">
    <div class="ex-entete" data-reveal>
      <span class="ex-nature">MESURES EN LABORATOIRE</span>
      <h2 class="ex-h2" id="v3-methode">Une campagne <em>de mesures.</em></h2>
      <p class="ex-lead">Ici, rien n’est extrapolé : l’énergie a été relevée pendant l’exécution. Mais seulement pour les GPU, sur des modèles <strong>ouverts</strong> que l’on peut faire tourner soi-même.</p>
    </div>
    <div class="ex-cartes" data-reveal-groupe>
      <article class="ex-carte"><span class="ex-carte-k">Source</span><h3>AI Energy Score</h3><p>Classement public hébergé par Hugging Face, qui compare l’énergie des modèles d’IA ouverts.</p></article>
      <article class="ex-carte"><span class="ex-carte-k">Campagne</span><h3>Février 2025</h3><p>{lignes.length} tâches, {evaluations} évaluations de modèles, sur carte NVIDIA H100.</p></article>
      <article class="ex-carte"><span class="ex-carte-k">Valeur affichée</span><h3>La médiane</h3><p>Pour chaque tâche, la valeur du milieu parmi les modèles testés : moins sensible aux extrêmes que la moyenne.</p></article>
      <article class="ex-carte"><span class="ex-carte-k">Unité</span><h3>Wh GPU par requête</h3><p>Fichiers d’origine en kWh pour 1 000 requêtes, ce qui revient au même nombre en Wh par requête.</p></article>
    </div>
  </section>

  <!-- 4. Transition -->
  <div class="ex-passage ex-largeur" data-reveal>
    <p class="ex-kicker">À VOUS</p>
    <h2 class="ex-h2">Les dix tâches, <em>côte à côte.</em></h2>
    <p>Le graphique classe les tâches de la plus à la moins gourmande. Commencez en échelle logarithmique pour tout voir, puis passez en linéaire pour ressentir les écarts.</p>
    <span class="ex-passage-fleche" aria-hidden="true"></span>
  </div>

  <!-- 5 et 6. Graphique et mode d'emploi -->
  <ExplorerGraphique viz={c.viz} label={c.label} note={c.note}>
    <li><strong>Basculez</strong> entre échelle logarithmique et linéaire avec les deux boutons.</li>
    <li><strong>Survolez</strong> une barre (ou donnez-lui le focus) pour lire sa médiane, sa fourchette et le nombre de modèles mesurés.</li>
    <li>Les tâches sont <strong>classées</strong> de la plus à la moins énergivore.</li>
    <li>Une valeur est une <strong>médiane</strong> : certains modèles consomment bien plus, d’autres bien moins.</li>
  </ExplorerGraphique>

  <!-- 7. Enseignements -->
  <section class="ex-section ex-largeur" aria-labelledby="v3-lecons">
    <div class="ex-entete" data-reveal>
      <p class="ex-kicker">CE QUE L’ON EN RETIENT</p>
      <h2 class="ex-h2" id="v3-lecons">Trois enseignements.</h2>
    </div>
    <div class="ex-chiffres" data-reveal-groupe>
      <article class="ex-chiffre"><p class="ex-chiffre-v"><small>×</small><span data-count={Math.round(rapport)} data-format="entier">{Math.round(rapport)}</span></p><p>Entre la médiane de la {haut.tache.toLowerCase()} et celle de la {bas.tache.toLowerCase()}.</p></article>
      <article class="ex-chiffre"><p class="ex-chiffre-v"><span data-count="2" data-format="entier">2</span><small>SUR {lignes.length}</small></p><p>Les deux tâches les plus gourmandes travaillent sur des images : {lignes[0].tache.toLowerCase()} et {lignes[1].tache.toLowerCase()}.</p></article>
      <article class="ex-chiffre"><p class="ex-chiffre-v"><small>×</small><span data-count={Math.round(texte.max_Wh_req / texte.min_Wh_req)} data-format="entier">{Math.round(texte.max_Wh_req / texte.min_Wh_req)}</span></p><p>Pour la génération de texte, entre le modèle le plus sobre et le plus gourmand des {texte.n_evaluations} mesurés : le choix du modèle compte autant que la tâche.</p></article>
    </div>
  </section>

  <!-- 8. Limites -->
  <section class="ex-section ex-largeur" aria-labelledby="v3-limites">
    <div class="ex-entete" data-reveal>
      <p class="ex-kicker">À GARDER EN TÊTE</p>
      <h2 class="ex-h2" id="v3-limites">Les limites <em>de ces mesures.</em></h2>
    </div>
    <ul class="ex-limites" data-reveal-groupe>
      <li><span><strong>Le GPU seulement.</strong> Le reste du serveur, le refroidissement et le réseau ne sont pas comptés : ce n’est pas la consommation d’un datacenter.</span></li>
      <li><span><strong>Des requêtes de test.</strong> Elles sont standardisées pour comparer les modèles ; vos propres requêtes peuvent être plus longues ou plus courtes.</span></li>
      <li><span><strong>Des modèles ouverts.</strong> Les grands assistants commerciaux ne sont pas mesurés ici.</span></li>
      <li><span><strong>Une campagne, un matériel.</strong> Février 2025, carte H100 : d’autres cartes ou réglages donneraient d’autres chiffres.</span></li>
    </ul>
  </section>

  <!-- 9. Conclusion -->
  <section class="ex-section ex-largeur">
    <div class="ex-fin" data-reveal>
      <p class="ex-kicker">EN RÉSUMÉ</p>
      <h2 class="ex-h2">Ce que l’on demande <em>change l’énergie nécessaire.</em></h2>
      <p>Créer une image mobilise bien plus les GPU que trier des phrases. L’énergie d’une requête dépend du modèle, mais aussi de la tâche.</p>
      <p class="ex-fin-probleme">Derrière une requête d’IA, il y a donc des puces qui calculent. Mais ces puces ne flottent pas dans un « nuage » : elles sont rangées quelque part.</p>
      <div class="ex-actions">
        <a class="ex-bouton" href="/explorer/v2">CHAPITRE 04 : LES INFRASTRUCTURES →</a>
        <a class="ex-bouton ex-bouton--ligne" href="/?face=3">RETOUR À L’EXPÉRIENCE</a>
      </div>
    </div>
  </section>
</div>

<script>
  import { mouvementReduit } from "../../scripts/explorer";

  // Galerie : chaque carte se retourne au clic ; « Révéler et classer » les range par énergie (animation FLIP).
  const galerie = document.querySelector<HTMLElement>("#v3-galerie");
  const classer = document.querySelector<HTMLButtonElement>("#v3-classer");
  if (galerie && classer) {
    const tuiles = [...galerie.querySelectorAll<HTMLButtonElement>(".v3-tuile")];
    const retourner = (t: HTMLButtonElement, ouvert = true) => t.setAttribute("aria-expanded", String(ouvert));
    tuiles.forEach((t) => t.addEventListener("click", () => retourner(t, t.getAttribute("aria-expanded") !== "true")));
    classer.addEventListener("click", () => {
      const avant = new Map(tuiles.map((t) => [t, t.getBoundingClientRect()]));
      const triees = [...tuiles].sort((a, b) => Number(b.dataset.valeur) - Number(a.dataset.valeur));
      triees.forEach((t, i) => {
        retourner(t);
        t.querySelector(".v3-tuile-rang")!.textContent = String(i + 1).padStart(2, "0");
        galerie.append(t);
      });
      galerie.classList.add("is-classee");
      classer.textContent = "CLASSÉES DE LA PLUS À LA MOINS GOURMANDE";
      classer.disabled = true;
      if (mouvementReduit()) return;
      triees.forEach((t, i) => {
        const a = avant.get(t)!, b = t.getBoundingClientRect();
        t.animate([{ transform: `translate(${a.left - b.left}px, ${a.top - b.top}px)` }, { transform: "none" }], { duration: 700 + i * 40, easing: "cubic-bezier(.2,.8,.2,1)" });
      });
    });
  }

  // Atelier d'échelle : bascule linéaire / logarithmique.
  const atelier = document.querySelector<HTMLElement>("#v3-atelier");
  atelier?.querySelectorAll<HTMLButtonElement>("[data-e]").forEach((b) => b.addEventListener("click", () => {
    atelier.dataset.echelle = b.dataset.e!;
    atelier.querySelectorAll("[data-e]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
  }));
</script>

<style>
  /* Ouverture : une puce dont les unités s'allument en vagues */
  .v3-puce { position: relative; justify-self: center; width: min(440px, 100%); aspect-ratio: 1; display: grid; place-items: center; }
  .v3-puce::before { content: ""; position: absolute; inset: 6%; border: 1px dashed #c4a9ff55; background: repeating-linear-gradient(90deg, transparent 0 18px, #c4a9ff22 18px 20px) top / 100% 8% no-repeat, repeating-linear-gradient(90deg, transparent 0 18px, #c4a9ff22 18px 20px) bottom / 100% 8% no-repeat; }
  .v3-puce-corps { position: relative; display: grid; grid-template-columns: repeat(12, 1fr); gap: 5px; width: 70%; padding: 16px; border: 1px solid #c4a9ff; background: #120f2c; box-shadow: 0 0 80px #c4a9ff33; }
  .v3-puce-corps i { aspect-ratio: 1; background: #c4a9ff; opacity: .12; animation: v3-calcul 2.3s ease-in-out infinite; animation-delay: calc(var(--d) * -1); }
  .v3-puce-nom { position: absolute; bottom: 10%; font: 500 11px var(--mono); letter-spacing: .3em; color: var(--accent); }
  @keyframes v3-calcul { 0%, 100% { opacity: .12; } 50% { opacity: .95; box-shadow: 0 0 8px #c4a9ff; } }

  /* Galerie des tâches */
  .v3-galerie { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 12px; }
  .v3-tuile { position: relative; display: grid; gap: 8px; align-content: start; min-height: 230px; padding: 16px; border: 1px solid #ffffff1f; background: #0c1530; color: #fff; text-align: left; font: inherit; cursor: pointer; transition: border-color .3s, background .3s; }
  .v3-tuile:hover { border-color: var(--accent); background: #111a3a; }
  .v3-tuile:focus-visible { outline: 2px solid #e9fbff; outline-offset: 3px; }
  .v3-tuile-nom { font: 800 21px/1.05 var(--titre); letter-spacing: .01em; }
  .v3-tuile-desc { color: #c3d1e7; font-size: 13.5px; line-height: 1.45; }
  .v3-tuile-verso { display: grid; gap: 6px; margin-top: auto; padding-top: 10px; border-top: 1px dashed #ffffff26; opacity: 0; transform: translateY(8px); transition: opacity .4s, transform .4s; }
  .v3-tuile[aria-expanded="true"] { border-color: color-mix(in srgb, var(--accent) 60%, transparent); background: #13173a; }
  .v3-tuile[aria-expanded="true"] .v3-tuile-verso { opacity: 1; transform: none; }
  .v3-tuile-v { font: 900 30px/1 var(--titre); color: var(--accent); font-variant-numeric: tabular-nums; }
  .v3-tuile-v small { font: 500 11px var(--mono); color: #c3d1e7; }
  .v3-tuile-barre { height: 6px; background: #ffffff14; }
