---
import ObservableViz from './ObservableViz.astro';
import { chapitres } from '../data/chapitres';

const chapters = chapitres;
---

<section class="experience" id="experience" aria-label="Derrière le prompt : exploration immersive">
  <div class="noise" aria-hidden="true"></div>
  <section class="intro" id="intro" aria-label="Introduction">
    <div class="intro-orbit orbit-one" aria-hidden="true"></div>
    <div class="intro-orbit orbit-two" aria-hidden="true"></div>
    <div class="intro-center">
      <p class="intro-overline">CONTEXTE · UNE EXPÉRIENCE INTERACTIVE</p>
      <h1 class="hero-heading"><button type="button" class="hero-title" id="hero-title" aria-describedby="intro-hint"><span>DERRIÈRE</span> <span>LE <em>PROMPT</em><b>.</b></span><i class="title-scan" aria-hidden="true"></i></button></h1>
      <p class="intro-hint" id="intro-hint">SURVOLEZ OU CLIQUEZ SUR LE TITRE</p>
      <form class="prompt-box" id="prompt-form" aria-label="Prompt fictif"><label for="prompt-input">ET SI TOUT COMMENÇAIT PAR UNE QUESTION ?</label><div class="prompt-line"><span aria-hidden="true">&gt;_</span><input id="prompt-input" name="prompt" type="text" maxlength="130" value="Pourquoi le ciel est-il bleu ?" autocomplete="off" required/><button type="submit">ENVOYER ↗</button></div><small>SIMULATION LOCALE — AUCUNE REQUÊTE ENVOYÉE À UNE IA</small></form>
      <div class="token-display" id="token-display" aria-live="polite"></div>
      <div class="credits" id="credits"><span>UNE EXPÉRIENCE DE</span><strong id="authors">NOAH LITZLER · CLÉMENT BERTRAND</strong></div>
      <button class="enter" id="enter" type="button">ENTRER DANS LES DONNÉES ↓</button>
    </div>
  </section>

  <main class="exploration" id="exploration" aria-label="Exploration des quatre visualisations">
  <div class="sticky-scene" id="sticky-scene">
    <div class="background-curves" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="cube-camera" id="cube-camera">
      <div class="cube" id="cube">
        {chapters.map((c,i)=>(
          <section class={`cube-face chapter-${c.kind}`} data-face={i} id={`chapitre-${c.n}`} aria-label={`${c.n} — ${c.k}`}>
            <div class="face-content">
              <header class="face-header">
                <div class="face-heading"><span class="eyebrow">{c.temps} · {c.n} / 04 — {c.k}</span><h2>{c.title.replace('\n',' ')}</h2></div>
                <p>{c.desc}</p>
              </header>
              <div class="viz-frame">
                <div class="viz-actions"><a class="explore-link" href={`/explorer/${c.viz}`} data-face-index={i} aria-label={`Explorer en grand : ${c.label}`}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M9.5 1.5h5v5M14.5 1.5 9 7M6.5 14.5h-5v-5M1.5 14.5 7 9"/></svg>Explorer</a></div>
                <ObservableViz viz={c.viz} label={c.label} class="viz-slot" />
              </div>
              <div class="face-foot"><span>{c.note}</span></div>
            </div>
          </section>
        ))}
      </div>
    </div>
    <nav class="chapter-nav" id="chapter-nav" aria-label="Accès aux quatre visualisations">
      {chapters.map((c,i)=><button type="button" class="nav-entry" data-nav-index={i} aria-label={`Aller au chapitre ${c.n} : ${c.k}`} aria-current="false"><span class="nav-tick"></span><span class="nav-tooltip">{c.temps} · {c.n} — {c.k}</span></button>)}
    </nav>
  </div>
</main>
<section class="outro" id="conclusion"><p class="outro-kicker">CONCLUSION · FIN DE L'EXPLORATION</p><h2>L'INVISIBLE <em>EXISTE.</em></h2><p>Une requête semble instantanée. Derrière elle, il y a de l'énergie, des ressources et des infrastructures physiques. Ces données donnent des ordres de grandeur, pas l'empreinte exacte de chaque prompt.</p><a href="/methode">DÉCOUVRIR NOTRE MÉTHODE ↗</a></section>
  <div class="hud" id="hud">
    <div class="hud-top">
      <button type="button" class="brand-logo" id="brand-logo" aria-label="Retour à l’introduction" title="Retour à l’introduction">
        <svg viewBox="0 0 100 100" role="img" aria-label="Logo moitié Terre, moitié robot" xmlns="http://www.w3.org/2000/svg"><g fill="currentColor"><path d="M47 8A42 42 0 0 0 47 92v-8A34 34 0 0 1 47 16V8Z"/><path d="M44 16c-7 1-12 4-17 9l5 3-5 6-9 3-2 11 8 5 9-2 6 6-3 11 7 14 4 2V16h-3Z"/><path d="M53 8a42 42 0 0 1 37 30l-7 3A34 34 0 0 0 53 16V8Z"/><path d="M53 22a28 28 0 0 1 0 56V22Z"/><rect x="58" y="47" width="18" height="8" rx="4" fill="#060915"/><path d="M87 24V9h6v15Z"/><circle cx="90" cy="7" r="6"/><rect x="89" y="43" width="7" height="21" rx="3.5"/><path d="M53 84a34 34 0 0 0 30-19l7 3A42 42 0 0 1 53 92v-8Z"/></g></svg>
      </button>
      <a href="/methode">MÉTHODE ↗</a>
    </div>
    <div class="hud-bottom"><span>SCROLL POUR EXPLORER ↓</span><div class="track"><div id="fill"></div></div><span id="counter">01 / 04</span></div>
  </div>
</section>

<style>
:global(html){scroll-behavior:smooth}
:global(body){margin:0;background:#070b19;color:#f3f5ff;font-family:Arial,sans-serif}
:global(*){box-sizing:border-box}
.experience{position:relative;isolation:isolate;background:#070b19}
.noise{position:absolute;inset:0;pointer-events:none;z-index:0;opacity:.18;background-image:radial-gradient(#c2d4ff5a .6px,transparent 1px);background-size:90px 85px}
.intro{min-height:100svh;position:relative;display:grid;place-items:center;overflow:hidden;padding:100px 24px 70px;background:radial-gradient(ellipse at 50% 45%,#172541,#080e20 58%,#070b19 95%)}
.intro-center{position:relative;z-index:2;width:min(1000px,94vw);display:flex;flex-direction:column;align-items:center;text-align:center}
.intro-orbit{position:absolute;width:85vmin;aspect-ratio:1;border:1px solid #9baefb23;border-radius:50%;pointer-events:none;animation:orbit-spin 42s linear infinite}.orbit-two{width:115vmin;border-color:#85e7ef14;animation-duration:55s;animation-direction:reverse}
.intro-overline,.intro-hint{font:500 10px 'IBM Plex Mono',monospace;letter-spacing:.2em;color:#9be5e7}.intro-overline{margin:0 0 28px}.intro-hint{margin:35px 0 0;color:#a4b3d2}
.hero-heading{margin:0;font:inherit}
.hero-title{position:relative;display:flex;flex-direction:column;align-items:center;border:0;padding:0 10px;background:transparent;color:#f4f6ff;font:900 clamp(58px,11vw,172px)/.78 'Barlow Condensed',Impact,sans-serif;letter-spacing:-.028em;cursor:crosshair;text-align:center}.hero-title span{white-space:nowrap}.hero-title em{font-style:normal;color:#a3b4ff}.hero-title b{color:#8ce5ec}.hero-title:hover,.hero-title:focus-visible{filter:drop-shadow(0 0 22px #7b9aff75)}.hero-title.processing{animation:hero-jolt .48s steps(3,end)}.title-scan{position:absolute;inset:0;background:linear-gradient(transparent 47%,#91efff66 50%,transparent 53%);opacity:0;pointer-events:none}.hero-title.processing .title-scan{animation:scan .65s ease-out}
.prompt-box{display:none;width:min(640px,90vw);margin-top:32px;padding:22px;background:#10192de8;border:1px solid #8da6df77;text-align:left}.intro.revealed .prompt-box{display:block}.prompt-box label,.prompt-box small{display:block;font:500 10px 'IBM Plex Mono',monospace;letter-spacing:.1em;color:#a7b9db}.prompt-line{display:flex;gap:12px;align-items:center;margin:13px 0;background:#060e1d;border:1px solid #4a5e83;padding:8px 10px}.prompt-line>span{color:#91e5e9;font-family:monospace}.prompt-line input{min-width:0;flex:1;color:#f0f4ff;font:15px 'IBM Plex Mono',monospace;background:transparent;border:0;outline:0}.prompt-line button,.enter{cursor:pointer;border:0;background:#99e6ed;color:#071122;font:600 11px 'IBM Plex Mono',monospace;padding:13px 15px}.prompt-line button:hover,.enter:hover{background:#c1f6f8}.prompt-box small{font-size:9px;color:#879abd}.intro.revealed .intro-hint{display:none}.token-display{display:none;max-width:680px;margin-top:18px;flex-wrap:wrap;justify-content:center;gap:6px}.intro.sent .token-display{display:flex}.token{padding:7px 10px;background:#9ae6ed15;border:1px solid #9ae6ed88;color:#baf2f5;font:11px 'IBM Plex Mono',monospace;animation:token-in .45s both}.credits{display:none;flex-direction:column;gap:8px;margin-top:22px;font:10px 'IBM Plex Mono',monospace;letter-spacing:.13em;color:#9eafd0}.credits strong{font-size:13px;color:#fff;min-height:1.5em}.intro.sent .credits{display:flex}.enter{display:none;margin-top:20px}.intro.sent .enter{display:block}.intro.sent .prompt-box{display:none}

/* V8 — rotation inversée, navigation dégagée ; un seul volume à quatre faces ; la page ne défile pas entre les graphiques */
.exploration{height:400svh;position:relative;background:linear-gradient(160deg,#080d1e,#10192d 52%,#080d1e)}
.sticky-scene{height:100svh;position:sticky;top:0;overflow:hidden;isolation:isolate}
.background-curves{position:absolute;inset:0;pointer-events:none;overflow:hidden;opacity:.55}
.background-curves i{position:absolute;display:block;width:80vw;height:80vw;left:-45vw;top:-30vw;border:1px solid #7be3f23d;border-radius:48% 52% 58% 42%;animation:orbit-spin 45s linear infinite}
.background-curves i:nth-child(2){width:65vw;height:65vw;left:auto;right:-34vw;top:15%;border-color:#a8a3ff45;animation-duration:65s;animation-direction:reverse}
.background-curves i:nth-child(3){width:90vw;height:30vw;left:20%;top:85%;border-color:#a2c3ff28;animation-duration:55s}
.cube-camera{position:absolute;inset:0 0 0 0;perspective:2300px;perspective-origin:50% 50%;pointer-events:none}
.cube{--face-depth:50svh;position:absolute;inset:0;transform-style:preserve-3d;transform:translateZ(calc(-1 * var(--face-depth))) rotateX(0deg);will-change:transform}
.cube-face{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:55px 72px 26px;backface-visibility:hidden;transform-style:preserve-3d;pointer-events:none;overflow:hidden;background:linear-gradient(145deg,#0b1325 0%,#0b1120 72%,#111b2c 100%)}
.cube-face[data-face="0"]{transform:rotateX(0deg) translateZ(var(--face-depth));--accent:#aab8ff}
.cube-face[data-face="1"]{transform:rotateX(-90deg) translateZ(var(--face-depth));--accent:#8be8e9}
.cube-face[data-face="2"]{transform:rotateX(-180deg) translateZ(var(--face-depth));--accent:#c4a9ff}
.cube-face[data-face="3"]{transform:rotateX(-270deg) translateZ(var(--face-depth));--accent:#96dfcb}
.cube-face.is-active{pointer-events:auto}
.face-content{width:100%;height:100%;max-height:none;display:flex;flex-direction:column;gap:5px;min-height:0}
.face-header{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:20px;align-items:end;min-height:0;flex:none}
.eyebrow{display:block;font:500 10px 'IBM Plex Mono',monospace;letter-spacing:.13em;color:var(--accent);margin-bottom:5px}
.face-header h2{font:900 clamp(29px,3.1vw,49px)/.95 'Barlow Condensed',Impact,sans-serif;margin:0;letter-spacing:.01em;text-wrap:balance}
.face-header p{font:14px/1.45 Arial,sans-serif;color:#c3d1e7;margin:0 0 3px;max-width:550px}
.viz-frame{min-height:0;flex:1;display:flex;flex-direction:column;padding:5px;border:1px solid color-mix(in srgb,var(--accent) 50%,#263b59);background:#0b1224;box-shadow:0 20px 55px #0005}
/* Bouton « Explorer » : ouvre la visualisation dans sa page dédiée */
.viz-actions{display:flex;justify-content:flex-end;margin-bottom:5px}
.explore-link{display:inline-flex;align-items:center;gap:7px;padding:4px 9px;border:1px solid color-mix(in srgb,var(--accent) 45%,transparent);color:var(--accent);background:color-mix(in srgb,var(--accent) 6%,transparent);font:500 9px 'IBM Plex Mono',monospace;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;transition:background .25s,border-color .25s,color .25s}
.explore-link svg{width:11px;height:11px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.explore-link:hover,.explore-link:focus-visible{background:color-mix(in srgb,var(--accent) 16%,transparent);border-color:var(--accent);color:#e9fbff}
.explore-link:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.viz-frame :global(.viz-slot){display:block;flex:1;min-height:0;width:100%;height:100%;background:#fbfaf7;overflow:hidden}
/* Le cadre sombre sert de bordure : le fond crème des graphiques va jusqu'aux bords, sans coins arrondis ni liseré. */
.viz-frame :global(.obs-viz-stage > *){border:0!important;border-radius:0!important}
.face-foot{flex:none;display:flex;justify-content:space-between;gap:10px;color:#a5b7d7;font:500 9px 'IBM Plex Mono',monospace;letter-spacing:.07em}
.chapter-nav{position:absolute;right:29px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:17px;z-index:20}
.nav-entry{position:relative;width:22px;height:22px;display:grid;place-items:center;background:none;border:0;cursor:pointer;padding:0}
.nav-tick{width:6px;height:6px;background:#9caecb;border-radius:50%;transition:.25s}
.nav-entry[aria-current="true"] .nav-tick,.nav-entry:hover .nav-tick{width:13px;height:13px;background:#8deaf0;box-shadow:0 0 18px #8deaf0}
.nav-tooltip{position:absolute;right:32px;top:50%;transform:translateY(-50%);background:#0c152bea;color:#e4efff;padding:8px 12px;border:1px solid #637ba1;font:10px 'IBM Plex Mono',monospace;white-space:nowrap;opacity:0;pointer-events:none}
.nav-entry:hover .nav-tooltip,.nav-entry:focus-visible .nav-tooltip{opacity:1}
.hud{position:fixed;z-index:30;inset:0;pointer-events:none}
.hud-top{position:absolute;top:20px;left:25px;right:25px;display:flex;justify-content:space-between;align-items:center}
.brand-logo{pointer-events:auto;width:43px;height:43px;padding:2px;border:0;background:none;color:#fff;cursor:pointer}.brand-logo svg{width:100%;height:100%}
.hud-top a{pointer-events:auto;text-decoration:none;color:#a4eff0;font:500 10px 'IBM Plex Mono',monospace;letter-spacing:.12em}
.hud-bottom{position:absolute;bottom:12px;left:25px;right:25px;display:flex;gap:18px;align-items:center;color:#a8b9d7;font:9px 'IBM Plex Mono',monospace}
.track{margin-left:auto;width:115px;height:2px;background:#4c5b7a}.track>div{height:100%;width:0;background:#8deaf0}
.outro{min-height:100svh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:110px 30px;background:#090f20}
.outro-kicker{font:11px 'IBM Plex Mono',monospace;color:#8deaf0}.outro h2{font:900 clamp(55px,8vw,110px)/.9 'Barlow Condensed',Impact,sans-serif;margin:24px 0}.outro h2 em{font-style:normal;color:#aab8ff}.outro p:not(.outro-kicker){max-width:640px;color:#c3d1e7;line-height:1.6}.outro a{margin-top:24px;color:#8deaf0;text-decoration:none;border:1px solid #8deaf0;padding:13px 20px;font:11px 'IBM Plex Mono',monospace}
@keyframes orbit-spin{to{rotate:360deg}}@keyframes hero-jolt{20%{transform:translateX(2px)}50%{transform:translateX(-3px)}100%{transform:none}}@keyframes scan{0%{opacity:0;transform:translateY(-30%)}35%{opacity:1}100%{opacity:0;transform:translateY(35%)}}@keyframes token-in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@media(max-width:800px){.cube-face{padding:76px 42px 42px 20px}.face-header{grid-template-columns:1fr;gap:5px}.face-header h2{font-size:clamp(27px,5vw,42px)}.face-header p{font-size:12px}.face-foot{font-size:8px}.nav-tooltip{display:none}}
@media(max-width:550px){.face-header h2{font-size:28px}.face-header p{font-size:11px}.cube-face{padding:72px 35px 37px 10px}.viz-frame{padding:5px}.hud-top{left:10px;right:10px}.hud-bottom{left:10px;right:10px}.hud-bottom>span:first-child{display:none}.chapter-nav{right:35px}}
@media(prefers-reduced-motion:reduce){.background-curves i,.intro-orbit,.token{animation:none!important}:global(html){scroll-behavior:auto}}
</style>
<script>
function initExperience(){
 const root=document.querySelector<HTMLElement>('#experience');
 if(!root||root.dataset.initialized==='true')return;
 root.dataset.initialized='true';
 const intro=root.querySelector<HTMLElement>('#intro')!;
 const title=root.querySelector<HTMLButtonElement>('#hero-title')!;
 const form=root.querySelector<HTMLFormElement>('#prompt-form')!;
 const input=root.querySelector<HTMLInputElement>('#prompt-input')!;
 const tokens=root.querySelector<HTMLElement>('#token-display')!;
 const authors=root.querySelector<HTMLElement>('#authors')!;
 const enter=root.querySelector<HTMLButtonElement>('#enter')!;
 const exploration=root.querySelector<HTMLElement>('#exploration')!;
 const cube=root.querySelector<HTMLElement>('#cube')!;
 const faces=Array.from(root.querySelectorAll<HTMLElement>('.cube-face'));
 const buttons=Array.from(root.querySelectorAll<HTMLButtonElement>('.nav-entry'));
 const fill=root.querySelector<HTMLElement>('#fill')!;
 const counter=root.querySelector<HTMLElement>('#counter')!;
 const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
 let sent=false, titleTimer=0, raf=0;
 function reveal(){intro.classList.add('revealed')}
 function animateTitle(){reveal();if(reduced)return;title.classList.remove('processing');void title.offsetWidth;title.classList.add('processing');clearTimeout(titleTimer);titleTimer=window.setTimeout(()=>title.classList.remove('processing'),680)}
 title.addEventListener('mouseenter',animateTitle);title.addEventListener('click',animateTitle);title.addEventListener('focus',animateTitle);
 form.addEventListener('submit',e=>{e.preventDefault();const value=input.value.trim();if(!value)return;sent=true;intro.classList.add('sent');tokens.replaceChildren();(value.match(/\S+\s*/g)||[]).slice(0,18).forEach((part,i)=>{const token=document.createElement('span');token.className='token';token.style.animationDelay=`${i*65}ms`;token.textContent=part.trim();tokens.append(token)});const full='NOAH LITZLER · CLÉMENT BERTRAND';if(reduced){authors.textContent=full}else{authors.textContent='';let i=0;const type=()=>{if(!authors.isConnected)return;authors.textContent=full.slice(0,++i);if(i<full.length)window.setTimeout(type,55)};window.setTimeout(type,350)}});
 const scrollTo=(el:HTMLElement)=>el.scrollIntoView({behavior:reduced?'instant':'smooth',block:'start'});
 enter.addEventListener('click',()=>{if(sent)scrollTo(exploration)});
 root.querySelector<HTMLButtonElement>('#brand-logo')?.addEventListener('click',()=>scrollTo(intro));
 function goTo(i:number){const travel=Math.max(1,exploration.offsetHeight-innerHeight);window.scrollTo({top:exploration.getBoundingClientRect().top+scrollY+travel*i/3,behavior:reduced?'instant':'smooth'})}
 buttons.forEach((b,i)=>b.addEventListener('click',()=>goTo(i)));
 // Pages Explorer : on mémorise la position avant de partir, et on la retrouve au retour
 // (ou la face demandée par ?face=, pour un lien direct depuis une page Explorer).
 root.querySelectorAll<HTMLAnchorElement>('.explore-link').forEach(a=>a.addEventListener('click',()=>{try{sessionStorage.setItem('dlp-retour',JSON.stringify({y:scrollY,face:Number(a.dataset.faceIndex)}))}catch{}}));
 function restaurerPosition(){
  let retour:{y?:number,face?:number}|null=null;
  try{retour=JSON.parse(sessionStorage.getItem('dlp-retour')||'null');sessionStorage.removeItem('dlp-retour')}catch{}
  const face=Number(new URLSearchParams(location.search).get('face'));
  if(retour?.y!=null){sent=true;intro.classList.add('sent');window.scrollTo({top:retour.y,behavior:'instant'})}
  else if(face>=1&&face<=4){sent=true;intro.classList.add('sent');const travel=Math.max(1,exploration.offsetHeight-innerHeight);window.scrollTo({top:exploration.getBoundingClientRect().top+scrollY+travel*(face-1)/3,behavior:'instant'})}
  // ?face= ne sert qu'une fois : un rechargement ultérieur repart de l'introduction.
  if(location.search)history.replaceState(null,'',location.pathname);
 }
 // Le défilement pilote le cube : on restaure nous-mêmes la position, y compris au retour
 // par le bouton Précédent quand le navigateur ressert la page depuis son cache.
 if('scrollRestoration' in history)history.scrollRestoration='manual';
 restaurerPosition();
 addEventListener('pageshow',e=>{if(e.persisted)restaurerPosition()});
 let rotationRaf=0,last=-1;
 function update(){
  rotationRaf=0;
  const rect=exploration.getBoundingClientRect();
  const distance=Math.max(1,rect.height-innerHeight);
  const t=Math.max(0,Math.min(1,-rect.top/distance));
  const position=t*3;
  const active=Math.min(3,Math.max(0,Math.round(position)));
  // Quatre faces solidaires : +90° par changement de graphique (sens inversé).
  cube.style.transform=`translateZ(calc(-1 * var(--face-depth))) rotateX(${position*90}deg)`;
  const inScene=rect.top<innerHeight*.65&&rect.bottom>innerHeight*.35;
  faces.forEach((face,i)=>{
   const interactive=inScene&&active===i&&Math.abs(position-i)<.08;
   face.classList.toggle('is-active',interactive);
   face.setAttribute('aria-hidden',String(!interactive));
   if('inert' in face)face.inert=!interactive;
  });
  buttons.forEach((b,i)=>b.setAttribute('aria-current',String(inScene&&active===i)));
  fill.style.width=`${Math.round(t*100)}%`;
  counter.textContent=`${String(active+1).padStart(2,'0')} / 04`;
  if(inScene&&active!==last){last=active;const face=faces[active];window.dispatchEvent(new CustomEvent('depth:card-shown',{detail:{card:face}}));}
 }
 function schedule(){if(!rotationRaf)rotationRaf=requestAnimationFrame(update)}
 addEventListener('scroll',schedule,{passive:true});addEventListener('resize',schedule);
 // Réactualisation des cartes et de la taille du cube lors d'un changement de viewport.
 update();
}
initExperience();
document.addEventListener('astro:page-load',initExperience);
</script>
<script is:inline>
/* DLP-METHOD-TRANSITION-V2 */
(function () {
  if (window.__dlpMethodTransition) return;
  window.__dlpMethodTransition = true;

  const style = document.createElement("style");
  style.textContent = `
    .dlp-method-overlay {
      position: fixed;
      inset: 0;
      z-index: 999999;
      display: grid;
      place-items: center;
      background: #070b19;
      opacity: 0;
      pointer-events: none;
      transition: opacity .35s ease;
    }

    .dlp-method-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    .dlp-method-overlay svg {
      width: min(35vw, 320px);
      height: min(35vw, 320px);
      color: #f5f9ff;
      opacity: 0;
      filter: drop-shadow(0 0 35px #8ce8f199);
      transform: scale(.1) rotate(-60deg);
    }

    .dlp-method-overlay.active svg {
      animation: dlp-logo-flight 1.3s ease-in-out forwards;
    }

    .dlp-method-flash {
      position: absolute;
      inset: 0;
      background: #baf8ff;
      opacity: 0;
    }

    .dlp-method-overlay.active .dlp-method-flash {
      animation: dlp-method-flash 1.3s forwards;
    }

    @keyframes dlp-logo-flight {
      0% { opacity: 0; transform: scale(.1) rotate(-60deg); }
      25% { opacity: 1; }
      60% { opacity: 1; transform: scale(1) rotate(0deg); }
      100% { opacity: 1; transform: scale(5) rotate(15deg); }
    }

    @keyframes dlp-method-flash {
      0%, 80% { opacity: 0; }
      100% { opacity: 1; }
    }

    @media (prefers-reduced-motion: reduce) {
      .dlp-method-overlay,
      .dlp-method-overlay * {
        animation: none !important;
        transition: none !important;
      }
    }
  `;
  document.head.appendChild(style);

  document.addEventListener("click", function (event) {
    const link = event.target.closest('a[href="/methode"]');
    if (!link) return;

    if (
      event.defaultPrevented ||
      event.button !== 0 ||
      event.ctrlKey ||
      event.metaKey ||
      event.shiftKey ||
      event.altKey
    ) return;

    event.preventDefault();

    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    if (reduced) {
      window.location.href = link.href;
      return;
    }

    const original = document.querySelector("#brand-logo svg");

    if (!original) {
      window.location.href = link.href;
      return;
    }

    const overlay = document.createElement("div");
    overlay.className = "dlp-method-overlay";
    overlay.setAttribute("aria-hidden", "true");

    const logo = original.cloneNode(true);
    logo.removeAttribute("aria-label");
    logo.removeAttribute("role");

    const flash = document.createElement("div");
    flash.className = "dlp-method-flash";

    overlay.append(logo, flash);
    document.body.appendChild(overlay);

    requestAnimationFrame(() => {
      overlay.classList.add("active");
    });

    setTimeout(() => {
      window.location.href = link.href;
    }, 1300);
  });
})();
</script>
