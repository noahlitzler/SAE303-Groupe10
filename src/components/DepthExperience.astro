---
import ObservableViz from './ObservableViz.astro';

const chapters = [

 {n:'01',k:'LE DÉCLENCHEUR',title:'UN TEXTE.\nDES MACHINES.',desc:'Une seule requête de 150 tokens n’est pas immatérielle. Choisissez un modèle : électricité, eau et CO₂e estimés par EcoLogits.',note:'ECOLOGITS / 150 TOKENS · MIX MONDIAL',x:0,y:0,z:-500,kind:'input',viz:'v4',label:'V4 — L’empreinte invisible d’une requête : compteurs interactifs d’électricité, d’eau et de CO₂e par modèle'},

 {n:'02',k:'MESURER L’ÉNERGIE',title:'TOUS LES MODÈLES\nNE SE VALENT PAS.',desc:'Huit configurations, huit sphères : leur surface suit l’électricité estimée pour une même réponse. Cliquez sur une sphère pour la comparer.',note:'ECOLOGITS / ESTIMATIONS DU 19/10/2026',x:0,y:-25,z:-2050,kind:'energy',viz:'v1',label:'V1 — Toutes les IA ne consomment pas autant : huit sphères EcoLogits proportionnelles à l’électricité estimée'},

 {n:'03',k:'COMPRENDRE LES ORDRES DE GRANDEUR',title:'CHANGER\nD’ÉCHELLE.',desc:'Dix tâches mesurées sur GPU par AI Energy Score : de la similarité de phrases à la génération d’images, l’énergie varie de plusieurs ordres de grandeur.',note:'AI ENERGY SCORE / CAMPAGNE FÉVRIER 2025',x:0,y:40,z:-3600,kind:'scale',viz:'v3',label:'V3 — Une tâche, un impact : énergie GPU médiane par requête pour dix tâches, échelle linéaire ou logarithmique'},

 {n:'04',k:'LES INFRASTRUCTURES',title:'LE NUMÉRIQUE\nA UNE ADRESSE.',desc:'23 installations dont la localisation a été vérifiée, en France et en Île-de-France, sans prétendre localiser le trajet d’un prompt.',note:'DATACENTERS FRANCE / © OPENSTREETMAP',x:0,y:-20,z:-5150,kind:'earth',viz:'v2',label:'V2 — Le numérique a une adresse : cartes des datacenters vérifiés en France et en Île-de-France'},

] as const;
---

<section class="experience" id="experience" aria-label="Derrière le prompt : exploration immersive">

 <div class="scene">

  <div class="noise" aria-hidden="true"></div>

  <div class="world" id="world">

   <div class="rail rail-a" aria-hidden="true"></div><div class="rail rail-b" aria-hidden="true"></div>

   {chapters.map((c)=> (

    <article class={`chapter chapter-${c.kind}`} data-z={c.z} style={`--x:${c.x}px;--y:${c.y}px;--z:${c.z}px`}>

     <div class="chapter-back" aria-hidden="true"></div>

     <div class="chapter-shell">

      <div class="chapter-texture" aria-hidden="true"></div>

      <div class="chapter-head"><span class="index">{c.n}</span><span class="chapter-kicker">{c.k}</span><span class="cross">✳</span></div>

      <div class="chapter-body"><div class="chapter-copy"><span class="eyebrow">DERRIÈRE LE PROMPT / {c.n}</span><h2>{c.title.split('\n').map((line)=><span>{line}</span>)}</h2><p>{c.desc}</p></div>

       <ObservableViz viz={c.viz} label={c.label} class="viz-slot" />

      </div>

      <div class="chapter-foot"><span>{c.note}</span><span>↗</span></div>

     </div>

    </article>

   ))}

  </div>

  <nav class="chapter-nav" id="chapter-nav" aria-label="Accès direct aux chapitres">

   <span class="nav-caption">NAVIGATION / 04</span>

   {chapters.map((c,i)=><button type="button" class="nav-entry" data-nav-index={i} aria-label={`Centrer le chapitre ${c.n} : ${c.k}`} aria-pressed="false"><span class="nav-tick"></span><span class="nav-number">{c.n}</span><span class="nav-name">{c.k}</span></button>)}

   <span class="nav-hint" id="nav-hint">SCROLL POUR REPRENDRE</span>

  </nav>

  <div class="intro" id="intro">

   <div class="intro-center">

    <p class="intro-overline">UNE EXPÉRIENCE INTERACTIVE</p>

    <button type="button" class="hero-title" id="hero-title" aria-label="Activer le titre et révéler le prompt"><span>DERRIÈRE</span><span>LE <em>PROMPT</em><b>.</b></span><i class="title-scan" aria-hidden="true"></i></button>

    <p class="intro-hint" id="intro-hint">SURVOLEZ OU CLIQUEZ SUR LE TITRE</p>

    <form class="prompt-box" id="prompt-form" aria-label="Prompt fictif"><label for="prompt-input">ET SI TOUT COMMENÇAIT PAR UNE QUESTION ?</label><div class="prompt-line"><span aria-hidden="true">&gt;\_</span><input id="prompt-input" name="prompt" type="text" maxlength="130" value="Pourquoi le ciel est-il bleu ?" autocomplete="off" required/><button type="submit">ENVOYER ↗</button></div><small>SIMULATION LOCALE — AUCUNE REQUÊTE ENVOYÉE À UNE IA</small></form>

    <div class="token-display" id="token-display" aria-live="polite"></div>

    <div class="credits" id="credits"><span>UNE EXPÉRIENCE DE</span><strong id="authors">NOAH LITZLER · CLÉMENT BERTRAND</strong></div>

    <button class="enter" id="enter" type="button">ENTRER DANS LES DONNÉES ↓</button>

   </div>

  </div>

  <div class="hud" id="hud"><div class="hud-top"><button type="button" class="brand-logo" id="brand-logo" aria-label="Retour à l’introduction" title="Retour à l’introduction">
  <svg viewBox="0 0 100 100" role="img" aria-label="Logo moitié Terre, moitié robot" xmlns="http://www.w3.org/2000/svg">
    <g fill="currentColor">
      <path d="M47 8A42 42 0 0 0 47 92v-8A34 34 0 0 1 47 16V8Z"/>
      <path d="M44 16c-7 1-12 4-17 9l5 3-5 6-9 3-2 11 8 5 9-2 6 6-3 11 7 14 4 2V16h-3Z"/>
      <path d="M53 8a42 42 0 0 1 37 30l-7 3A34 34 0 0 0 53 16V8Z"/>
      <path d="M53 22a28 28 0 0 1 0 56V22Z"/>
      <rect x="58" y="47" width="18" height="8" rx="4" fill="#060915"/>
      <path d="M87 24V9h6v15Z"/><circle cx="90" cy="7" r="6"/>
      <rect x="89" y="43" width="7" height="21" rx="3.5"/>
      <path d="M53 84a34 34 0 0 0 30-19l7 3A42 42 0 0 1 53 92v-8Z"/>
    </g>
  </svg>
</button><a href="/methode">MÉTHODE ↗</a></div><div class="hud-bottom"><span>SCROLL POUR EXPLORER ↓</span><div class="track"><div id="fill"></div></div><span id="counter">01 / 04</span></div></div>

 </div>

</section>

<style>

 @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600&display=swap');

 :global(html){scroll-behavior:auto} :global(body){margin:0;background:#060915;color:#f3f5ff;font-family:Arial,sans-serif}

 .experience{height:920vh;position:relative}.scene{height:100svh;position:sticky;top:0;overflow:hidden;perspective:1200px;background:radial-gradient(ellipse at 50% 50%,#19233e 0%,#090f21 50%,#050815 100%)}

 .noise{position:absolute;inset:0;pointer-events:none;opacity:.35;background-image:repeating-linear-gradient(0deg,transparent 0 3px,#b6caff08 4px),radial-gradient(#a2c9ff80 .7px,transparent 1px);background-size:auto,97px 83px;mask-image:linear-gradient(to bottom,transparent,black 18%,black 82%,transparent)}

 .world{position:absolute;inset:0;transform-style:preserve-3d;will-change:transform;pointer-events:none}.rail{position:absolute;left:50%;top:50%;width:2px;height:2px;border-radius:50%;box-shadow:0 0 0 100px #7d9eff08,0 0 0 260px #7d9eff06,0 0 0 500px #7d9eff04}.rail-b{transform:translate3d(260px,-120px,-2200px);box-shadow:0 0 0 130px #72dce609,0 0 0 400px #72dce605}

 .chapter{position:absolute;top:50%;left:50%;width:min(1250px,88vw);height:min(720px,82vh);transform:translate(-50%,-50%) translate3d(var(--x),var(--y),var(--z)) rotateY(-5deg);transform-style:preserve-3d;pointer-events:auto;will-change:opacity;--accent:#a3b4ff}

 .chapter-energy{--accent:#8be8e9;transform:translate(-50%,-50%) translate3d(var(--x),var(--y),var(--z)) rotateY(5deg)}.chapter-scale{--accent:#c4a9ff}.chapter-earth{--accent:#96dfcb;transform:translate(-50%,-50%) translate3d(var(--x),var(--y),var(--z)) rotateY(5deg)}

 .chapter-back{position:absolute;inset:0;transform:translateZ(-23px) translate(12px,10px);background:#2a3555;border:1px solid var(--accent);clip-path:polygon(0 0,96% 0,100% 8%,100% 100%,0 100%);opacity:.8}

 .chapter-shell{position:absolute;inset:0;transform:translateZ(13px);padding:28px 34px;display:flex;flex-direction:column;overflow:hidden;border:1px solid color-mix(in srgb,var(--accent) 65%,transparent);background:linear-gradient(125deg,#1a243cfa 0%,#0d1528f5 68%,#131e34f9);clip-path:polygon(0 0,96% 0,100% 8%,100% 100%,0 100%);box-shadow:inset 0 0 80px #a6c0ff0b,0 30px 80px #0009}

 .chapter-texture{position:absolute;inset:0;pointer-events:none;opacity:.8;background:repeating-linear-gradient(90deg,transparent 0 38px,#a4b9ee0a 39px),repeating-linear-gradient(0deg,transparent 0 38px,#a4b9ee09 39px),linear-gradient(155deg,transparent 0 65%,color-mix(in srgb,var(--accent) 12%,transparent));mask-image:linear-gradient(110deg,transparent 12%,black 65%)}

 .chapter:before{content:'';position:absolute;z-index:3;left:0;top:0;width:32%;height:3px;background:var(--accent);box-shadow:0 0 24px var(--accent)}

 .chapter-head,.chapter-foot{position:relative;z-index:1;display:flex;align-items:center;gap:16px;font:500 10px 'IBM Plex Mono',monospace;letter-spacing:.14em;color:#aebdd9}.chapter-head{padding-bottom:18px;border-bottom:1px solid #a9bce333}.index{font:800 42px 'Barlow Condensed',sans-serif;color:var(--accent);letter-spacing:0}.cross{margin-left:auto;color:var(--accent);font-size:23px}.chapter-body{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2.5fr);gap:20px;align-items:center;flex:1}.eyebrow{font:500 10px 'IBM Plex Mono',monospace;color:var(--accent);letter-spacing:.15em}.chapter-copy h2{font:900 clamp(35px,4vw,59px)/.9 'Barlow Condensed',Impact,sans-serif;letter-spacing:-.01em;margin:18px 0;white-space:normal}.chapter-copy h2 span{display:block}.chapter-copy p{max-width:350px;color:#c3cbe0;font-size:14px;line-height:1.7}.artifact{position:relative;height:100%;min-height:420px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:25px;overflow:hidden;border-left:1px solid #a7b7e433;background:radial-gradient(ellipse at center,color-mix(in srgb,var(--accent) 15%,transparent),transparent 60%);font:500 9px 'IBM Plex Mono',monospace;letter-spacing:.1em;color:#aab9d9}.artifact:before,.artifact:after{content:'';position:absolute;inset:16px 32px;border:1px solid color-mix(in srgb,var(--accent) 35%,transparent);border-radius:50%;transform:rotateX(68deg) rotate(-30deg)}.artifact:after{inset:35px 62px;transform:rotateX(65deg) rotate(45deg)}.artifact-core{width:28px;height:28px;border:1px solid var(--accent);border-radius:50%;background:var(--accent);box-shadow:0 0 22px var(--accent),0 0 80px var(--accent);opacity:.85}.artifact span{position:relative;z-index:1}.artifact-energy:before{border-radius:0;transform:rotate(35deg)}.artifact-scale:before{transform:rotateX(65deg)}.artifact-earth:before{border-style:dashed}.chapter-foot{padding-top:17px;border-top:1px solid #a9bce333;justify-content:space-between}.chapter-foot span:last-child{font-size:21px;color:var(--accent)}

 .intro{position:absolute;inset:0;z-index:10;background:radial-gradient(ellipse at center,#0b1329ed,#060915fc 75%);display:grid;place-items:center;transition:opacity .2s;pointer-events:auto}.intro-center{width:min(1000px,92vw);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}.intro-overline{font:500 11px 'IBM Plex Mono',monospace;letter-spacing:.26em;color:#9be5e7;margin:0 0 25px}.hero-title{position:relative;isolation:isolate;display:flex;flex-direction:column;align-items:center;border:0;padding:0 10px;background:transparent;color:#f4f6ff;font:900 clamp(78px,11vw,184px)/.76 'Barlow Condensed',Impact,sans-serif;letter-spacing:-.028em;cursor:crosshair;text-align:center;transition:filter .2s,transform .5s}.hero-title span{white-space:nowrap}.hero-title em{font-style:normal;color:#a3b4ff}.hero-title b{color:#8ce5ec}.hero-title:hover,.hero-title:focus-visible{filter:drop-shadow(0 0 22px #7b9aff75)}.hero-title:focus-visible{outline:2px solid #8ce5ec;outline-offset:10px}.hero-title.processing{animation:hero-jolt .48s steps(3,end)}.title-scan{position:absolute;inset:0;background:linear-gradient(transparent 47%,#91efff66 50%,transparent 53%);opacity:0;pointer-events:none}.hero-title.processing .title-scan{animation:scan .65s ease-out}.intro-hint{font:500 10px 'IBM Plex Mono',monospace;letter-spacing:.15em;color:#a4b3d2;margin:38px 0 0}.prompt-box{display:none;width:min(640px,90vw);margin-top:32px;padding:22px;background:#10192de8;border:1px solid #8da6df77;box-shadow:0 18px 80px #0006;text-align:left}.intro.revealed .prompt-box{display:block}.prompt-box label,.prompt-box small{display:block;font:500 10px 'IBM Plex Mono',monospace;letter-spacing:.1em;color:#a7b9db}.prompt-line{display:flex;gap:12px;align-items:center;margin:13px 0;background:#060e1d;border:1px solid #4a5e83;padding:8px 10px}.prompt-line>span{color:#91e5e9;font-family:monospace}.prompt-line input{min-width:0;flex:1;color:#f0f4ff;font:15px 'IBM Plex Mono',monospace;background:transparent;border:0;outline:0}.prompt-line button,.enter{cursor:pointer;border:0;background:#99e6ed;color:#071122;font:600 11px 'IBM Plex Mono',monospace;padding:13px 15px}.prompt-line button:hover,.enter:hover{background:#c1f6f8}.prompt-box small{font-size:9px;color:#879abd}.intro.revealed .intro-hint{display:none}.token-display{display:none;max-width:680px;margin-top:18px;flex-wrap:wrap;justify-content:center;gap:6px}.intro.sent .token-display{display:flex}.token{padding:7px 10px;background:#9ae6ed15;border:1px solid #9ae6ed88;color:#baf2f5;font:11px 'IBM Plex Mono',monospace;animation:token-in .45s both}.credits{display:none;flex-direction:column;gap:8px;margin-top:22px;font:10px 'IBM Plex Mono',monospace;letter-spacing:.13em;color:#9eafd0}.credits strong{font-size:13px;color:#fff;min-height:1.5em}.intro.sent .credits{display:flex}.enter{display:none;margin-top:20px}.intro.sent .enter{display:block}.intro.sent .prompt-box{display:none}

 .hud{position:absolute;inset:0;z-index:5;pointer-events:none;opacity:0;transition:opacity .2s}.hud-top,.hud-bottom{position:absolute;left:4%;right:4%;display:flex;align-items:center;justify-content:space-between;font:500 10px 'IBM Plex Mono',monospace;letter-spacing:.1em;color:#a9bbdd}.hud-top{top:28px}.hud-top a{pointer-events:auto;color:#9de4e9;text-decoration:none}.mini-brand{font:800 24px 'Barlow Condensed',sans-serif;letter-spacing:0;color:#fff}.mini-brand b{color:#a3b4ff}.hud-bottom{bottom:26px;gap:18px}.track{margin-left:auto;width:140px;height:2px;background:#ffffff25}.track>div{height:100%;width:0;background:#9de4e9;box-shadow:0 0 12px #9de4e9}


 /* Logo de navigation : blanc, net et lisible à petite taille */
 .brand-logo{pointer-events:auto;display:grid;place-items:center;width:48px;height:48px;padding:4px;border:0;background:transparent;color:#fff;cursor:pointer;transform-origin:center;transition:transform .45s cubic-bezier(.2,.8,.2,1),filter .3s,color .3s}
 .brand-logo svg{width:100%;height:100%;overflow:visible}
 .brand-logo:hover,.brand-logo:focus-visible{color:#a3b4ff;transform:rotate(-9deg) scale(1.13);filter:drop-shadow(0 0 12px #91e8ff90)}
 .brand-logo:focus-visible{outline:2px solid #8ce5ec;outline-offset:4px;border-radius:6px}
 @media(prefers-reduced-motion:reduce){.brand-logo{transition:none}}

 /* Navigation latérale : elle reste hors de la scène 3D et ne subit pas la perspective. */

 .chapter-nav{position:absolute;z-index:8;right:clamp(16px,2.2vw,42px);top:50%;transform:translateY(-50%);display:flex;flex-direction:column;align-items:flex-end;gap:7px;pointer-events:none;opacity:0;transition:opacity .35s ease;font-family:'IBM Plex Mono',monospace}

 .chapter-nav.is-visible{opacity:1;pointer-events:auto}

 .nav-caption{font-size:9px;letter-spacing:.18em;color:#8a9bbd;margin-bottom:15px}

 .nav-entry{width:190px;min-height:39px;display:flex;align-items:center;justify-content:flex-end;gap:11px;border:0;background:transparent;color:#8394b7;cursor:pointer;text-align:right;font:500 10px 'IBM Plex Mono',monospace;letter-spacing:.07em;transition:color .2s,transform .2s}

 .nav-entry:hover,.nav-entry:focus-visible,.nav-entry[aria-pressed="true"]{color:#e8f7ff;transform:translateX(-5px)}

 .nav-entry:focus-visible{outline:1px solid #8de9ef;outline-offset:2px}

 .nav-name{max-width:124px;font-size:9px;line-height:1.4}.nav-number{font-size:11px;color:inherit}.nav-tick{order:3;width:17px;height:2px;background:#61718e;transition:width .3s,*background* .3s,box-shadow .3s}

 .nav-entry[aria-pressed="true"] .nav-tick{width:29px;background:#9deaf1;box-shadow:0 0 13px #9deaf1}

 .nav-hint{font-size:8px;letter-spacing:.08em;color:#8fe3ea;margin-top:13px;opacity:0;transition:opacity .2s}.chapter-nav.is-focused .nav-hint{opacity:1}

 .world.is-focusing{transition:transform 850ms cubic-bezier(.2,.7,.2,1)}

 .chapter{transition:opacity .35s ease,filter .6s ease}

 .chapter.is-selected{filter:drop-shadow(0 0 28px color-mix(in srgb,var(--accent) 30%,transparent));transform:translate(-50%,-50%) translate3d(var(--x),var(--y),var(--z)) rotateY(0deg);transition:opacity .35s ease,transform .85s cubic-bezier(.2,.7,.2,1),filter .6s ease}

 @media(max-width:1050px){.chapter-nav{right:10px}.nav-entry{width:58px}.nav-name,.nav-caption{display:none}.nav-hint{font-size:7px;max-width:70px;text-align:right}}

 @media(prefers-reduced-motion:reduce){.world.is-focusing,.chapter,.chapter.is-selected,.chapter-nav,.nav-entry{transition:none}}

 @keyframes hero-jolt{20%{transform:translateX(2px);text-shadow:3px 0 #8df2fa,-3px 0 #8c74ff}50%{transform:translateX(-3px);text-shadow:-4px 0 #8df2fa,3px 0 #8c74ff}100%{transform:none;text-shadow:none}}@keyframes scan{0%{opacity:0;transform:translateY(-30%)}35%{opacity:1}100%{opacity:0;transform:translateY(35%)}}@keyframes token-in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

 @media(max-width:800px){.hero-title{font-size:clamp(58px,13vw,115px)}.chapter{width:80vw;height:440px;transform:translate(-50%,-50%) translate3d(calc(var(--x) * .18),var(--y),var(--z))}.chapter-body{grid-template-columns:1fr}.artifact{height:100px;gap:4px}.artifact:before,.artifact:after{display:none}.artifact-core{width:12px;height:12px}.chapter-copy h2{font-size:35px}.chapter-copy p{font-size:12px}.chapter-shell{padding:20px}.chapter-head{padding-bottom:8px}.chapter-foot{padding-top:8px}.prompt-line{flex-wrap:wrap}.prompt-line button{margin-left:auto}}

 @media(prefers-reduced-motion:reduce){.hero-title,.intro,.hud{transition:none}.hero-title.processing,.hero-title.processing .title-scan,.token{animation:none}}


/* Ajustements des grandes cards */
.chapter-body {
  min-height: 0;
}

.chapter-copy,
.artifact {
  min-width: 0;
}

.chapter-shell {
  box-sizing: border-box;
}

@media (min-width: 801px) and (max-width: 1100px) {
  .chapter {
    width: 88vw;
    height: min(650px, 80vh);
  }

  .chapter-body {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr);
  }

  .artifact {
    min-height: 320px;
  }
}

@media (max-width: 800px) {
  .chapter {
    width: 88vw;
    height: min(720px, 84vh);
  }

  .chapter-body {
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }

  .artifact {
    height: auto;
    min-height: 180px;
  }

  .chapter-shell {
    padding: 20px;
  }
}

/* Visualisations Observable dans les cards */
.chapter-body {
  grid-template-rows: minmax(0, 1fr);
}

.chapter-body :global(.viz-slot) {
  align-self: stretch;
  height: 100%;
  padding: 2px;
  box-sizing: border-box;
}

/* Le fond clair d'origine est conservé ; un liseré et un halo à la couleur du chapitre l'intègrent à la card sombre. */
.chapter-body :global(.viz-slot .obs-viz-stage > section) {
  box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 55%, transparent), 0 0 42px color-mix(in srgb, var(--accent) 16%, transparent), 0 24px 60px #0009;
}

@media (max-width: 800px) {
  .chapter-body {
    grid-template-rows: auto minmax(0, 1fr);
  }

  .chapter-copy .eyebrow,
  .chapter-copy p {
    display: none;
  }

  .chapter-copy h2 {
    font-size: 28px;
    margin: 0;
  }
}

</style>

<script>

 function initExperience(){

  const section=document.querySelector<HTMLElement>('#experience');const world=document.querySelector<HTMLElement>('#world');const intro=document.querySelector<HTMLElement>('#intro');const hud=document.querySelector<HTMLElement>('#hud');const title=document.querySelector<HTMLButtonElement>('#hero-title');const form=document.querySelector<HTMLFormElement>('#prompt-form');const input=document.querySelector<HTMLInputElement>('#prompt-input');const tokens=document.querySelector<HTMLElement>('#token-display');const authors=document.querySelector<HTMLElement>('#authors');const enter=document.querySelector<HTMLButtonElement>('#enter');const fill=document.querySelector<HTMLElement>('#fill');const counter=document.querySelector<HTMLElement>('#counter');

  if(!section||!world||!intro||!hud||!title||!form||!input||!tokens||!authors||!enter||!fill||!counter)return;

  const cards=Array.from(world.querySelectorAll<HTMLElement>('.chapter'));const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;let sent=false;let tick=false;let titleTimer=0;

  function reveal(){intro!.classList.add('revealed')}

  function animateTitle(){reveal();if(reduced)return;title!.classList.remove('processing');void title!.offsetWidth;title!.classList.add('processing');clearTimeout(titleTimer);titleTimer=window.setTimeout(()=>title!.classList.remove('processing'),680)}

  title.addEventListener('mouseenter',animateTitle);title.addEventListener('click',animateTitle);title.addEventListener('focus',animateTitle);

  form.addEventListener('submit',(event)=>{event.preventDefault();const value=input!.value.trim();if(!value)return;sent=true;intro!.classList.add('sent');tokens!.replaceChildren();const parts=value.match(/\S+\s*/g)?.slice(0,18)||[];parts.forEach((part,i)=>{const token=document.createElement('span');token.className='token';token.style.animationDelay=`${i*65}ms`;token.textContent=part.trim();tokens!.append(token)});const full='NOAH LITZLER · CLÉMENT BERTRAND';if(reduced){authors!.textContent=full}else{authors!.textContent='';let i=0;const type=()=>{if(!authors||!authors.isConnected)return;authors.textContent=full.slice(0,++i);if(i<full.length)window.setTimeout(type,55)};window.setTimeout(type,350)};update()});

  enter.addEventListener('click',()=>{if(!sent)return;const rect=section!.getBoundingClientRect();const introDistance=(section!.offsetHeight-innerHeight)*.16;window.scrollTo({top:window.scrollY+rect.top+introDistance,behavior:reduced?'auto':'smooth'})});

  // Le menu ne déplace pas le scroll : il place temporairement la caméra face à la card.

  // Un geste de défilement annule ce cadrage et rend immédiatement la main au parcours original.

  const nav=document.querySelector<HTMLElement>('#chapter-nav');

  const navButtons=Array.from(document.querySelectorAll<HTMLButtonElement>('.nav-entry'));

  let focusedIndex:number|null=null;

  let lastScrollY=window.scrollY;

  let focusTimer=0;

  // Prévient les visualisations qu'une card est visible ou centrée (échelle et cartes Leaflet à recalculer).
  const shownCards=new Set<HTMLElement>();

  function announceCard(card:HTMLElement){window.dispatchEvent(new CustomEvent('depth:card-shown',{detail:{card}}))}

  // Les gestes faits dans un graphique (déplacer une carte, choisir un modèle au clavier) ne quittent pas le cadrage.
  function insideViz(target:EventTarget|null){return target instanceof Element&&target.closest('.obs-viz')!==null}

  function setMenuState(active:number|null){

    nav?.classList.toggle('is-focused',active!==null);

    navButtons.forEach((button,i)=>button.setAttribute('aria-pressed',String(active===i)));

  }

  function releaseFocus(){

    if(focusedIndex===null)return;

    focusedIndex=null;

    window.clearTimeout(focusTimer);

    cards.forEach(card=>card.classList.remove('is-selected'));

    setMenuState(null);

    world!.classList.add('is-focusing');

    update();

    focusTimer=window.setTimeout(()=>world!.classList.remove('is-focusing'),900);

  }

  function focusCard(index:number){

    if(!sent)return;

    const card=cards[index];if(!card)return;

    window.clearTimeout(focusTimer);

    focusedIndex=index;

    world!.classList.add('is-focusing');

    cards.forEach((item,i)=>{

      item.classList.toggle('is-selected',i===index);

      item.style.opacity=i===index?'1':'0.08';

      item.style.pointerEvents=i===index?'auto':'none';

    });

    const x=parseFloat(card.style.getPropertyValue('--x'))||0;

    const y=parseFloat(card.style.getPropertyValue('--y'))||0;

    const z=Number(card.dataset.z)||0;

    // Les translations compensent la position latérale et la profondeur de la card.

    world!.style.transform=`translate3d(${-x}px,${-y}px,${-z}px)`;

    setMenuState(index);

    focusTimer=window.setTimeout(()=>announceCard(card),900);

    counter!.textContent=`${String(index+1).padStart(2,'0')} / 04`;

    fill!.style.width=`${((index+1)/4)*100}%`;

  }

  navButtons.forEach((button,i)=>button.addEventListener('click',()=>focusCard(i)));

   document.querySelector<HTMLButtonElement>('#brand-logo')?.addEventListener('click',()=>{
     releaseFocus();
     window.scrollTo({top:window.scrollY+section!.getBoundingClientRect().top,behavior:reduced?'auto':'smooth'});
   });

  function update(){

    const distance=Math.max(1,section!.offsetHeight-innerHeight);

    const p=Math.max(0,Math.min(1,-section!.getBoundingClientRect().top/distance));

    const introPart=.16;

    const introOpacity=sent?1-Math.max(0,Math.min(1,(p-.06)/.10)):1;

    intro!.style.opacity=String(introOpacity);

    intro!.style.pointerEvents=sent&&p>.13?'none':'auto';

    intro!.style.visibility=introOpacity<.01?'hidden':'visible';

    const visible=sent&&p>.145;

    hud!.style.opacity=String(visible?1:0);

    nav?.classList.toggle('is-visible',visible);

    if(focusedIndex!==null){tick=false;return;}

    const travel=Math.max(0,Math.min(1,(p-introPart)/(1-introPart)));

    const camera=travel*5650;

    world!.style.transform=`translate3d(0,0,${camera}px)`;

    cards.forEach(card=>{

      const depth=Number(card.dataset.z)+camera;

      const alpha=depth<170?1:Math.max(0,1-(depth-170)/560);

      card.style.opacity=String(alpha);

      card.style.pointerEvents=alpha<.18?'none':'auto';

      if(alpha<.18)shownCards.delete(card);else if(!shownCards.has(card)){shownCards.add(card);announceCard(card)}

    });

    fill!.style.width=`${travel*100}%`;

    counter!.textContent=`${String(Math.min(4,Math.floor(travel*4)+1)).padStart(2,'0')} / 04`;

    tick=false;

  }

  function requestUpdate(){

    if(!tick){tick=true;requestAnimationFrame(update)}

  }

  addEventListener('scroll',()=>{

    if(Math.abs(window.scrollY-lastScrollY)>1&&focusedIndex!==null)releaseFocus();

    lastScrollY=window.scrollY;

    requestUpdate();

  },{passive:true});

  // Au bord d'une section, un geste de molette peut ne pas produire de scroll.

  addEventListener('wheel',(e)=>{if(focusedIndex!==null&&Math.abs(e.deltaY)>1)releaseFocus()},{passive:true});

  addEventListener('touchmove',(e)=>{if(focusedIndex!==null&&!insideViz(e.target))releaseFocus()},{passive:true});

  addEventListener('keydown',(e)=>{if(focusedIndex!==null&&!insideViz(e.target)&&['ArrowDown','ArrowUp','PageDown','PageUp',' ','Home','End'].includes(e.key))releaseFocus()});

  addEventListener('resize',requestUpdate);

  update();

 }

 initExperience();

</script>

