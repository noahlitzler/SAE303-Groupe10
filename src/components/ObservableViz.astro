---
// Emplacement d'une visualisation du notebook Observable. Le graphique (un <figure> avec sa
// <figcaption> et son alternative textuelle) est dessiné côté navigateur par src/visualisations/client.ts.
// mode « carte » : il tient dans le rectangle d'une face du cube ; mode « page » : page Explorer.
interface Props {
  viz: "v1" | "v2" | "v3" | "v4";
  label: string;
  mode?: "carte" | "page";
  class?: string;
}

const { viz, label, mode = "carte", class: className } = Astro.props;
---

<div class:list={["obs-viz", `obs-viz--${mode}`, className]} data-obs-viz={viz} data-obs-mode={mode} aria-busy="true">
  <div class="obs-viz-stage"></div>
  <p class="obs-viz-status" role="status"><span class="sr-only">{label} — </span>CHARGEMENT DE LA VISUALISATION…</p>
  <noscript><p class="obs-viz-status">{label} — cette visualisation interactive nécessite JavaScript.</p></noscript>
</div>

<style>
  .obs-viz {
    position: relative;
    margin: 0;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  .obs-viz-stage {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    transform-origin: 0 0;
  }

  /* Page Explorer : le graphique suit le flux de la page, sans réduction. */
  .obs-viz--page {
    min-height: 60vh;
    overflow: visible;
  }

  .obs-viz--page .obs-viz-stage {
    position: relative;
  }

  .obs-viz.is-overflowing {
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .obs-viz-status {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    padding: 24px;
    text-align: center;
    font: 500 10px/1.6 "IBM Plex Mono", monospace;
    letter-spacing: 0.12em;
    color: #5b616b;
    pointer-events: none;
  }

  .obs-viz.is-ready .obs-viz-status {
    display: none;
  }

  .obs-viz.is-error .obs-viz-status {
    color: #b42318;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  // Chargé à part pour ne pas retarder l'introduction et la scène 3D.
  import("../visualisations/client").then(({ monterVisualisations }) => monterVisualisations());
</script>
